---
import { url } from '../../lib';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { categories, statuses } from '../../site';

export async function getStaticPaths() {
  const projets = await getCollection('projets');
  return projets.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const d = p.data;
---
<Base title={d.title} description={d.summary}>
  <div class="wrap">
    <div class="project-hero">
      <a class="back" href={url('#projets')}>← Tous les projets</a>
      <div class="meta">
        <span class="badge">{categories[d.category]}</span>
        <span class={`badge ${d.status === 'en-ligne' ? 'live' : ''}`}>{statuses[d.status]}</span>
        <span>{d.year}</span>
      </div>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
    </div>
    <div class="project-layout">
      <article>
        <div class="cover project-cover" style={`--h:${d.hue}`} aria-hidden="true"><span>{d.title.trim().charAt(0).toUpperCase()}</span></div>
        <div class="prose"><Content /></div>
      </article>
      <aside class="aside" aria-label="Informations sur le projet">
        {d.stack.length > 0 && (
          <div>
            <h2>Technologies</h2>
            <ul class="tags" role="list">{d.stack.map((s) => <li>{s}</li>)}</ul>
          </div>
        )}
        {d.links.length > 0 && (
          <div>
            <h2>Liens</h2>
            <div class="links">
              {d.links.map((l, i) => <a class={`btn ${i === 0 ? 'primary' : ''}`} href={l.url} rel="noopener">{l.label} ↗</a>)}
            </div>
          </div>
        )}
      </aside>
    </div>
  </div>
</Base>
