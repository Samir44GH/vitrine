---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sigil from '../../components/Sigil.astro';
import { categories, statuses } from '../../site';
import { url } from '../../lib';

export async function getStaticPaths() {
  // Même tri que la page d'accueil, pour que « suivant » suive vraiment.
  const projets = (await getCollection('projets')).sort(
    (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
  );
  return projets.map((p, i) => ({
    params: { id: p.id },
    props: { p, prev: projets[i - 1] ?? null, next: projets[i + 1] ?? null },
  }));
}
const { p, prev, next } = Astro.props;
const { Content } = await render(p);
const d = p.data;
---
<Base title={d.title} description={d.summary}>
  <div class="wrap">
    <div class="project-hero">
      <a class="back" href={url('#projets')}>← Tous les projets</a>
      <div class="project-head">
        <span class="sigil"><Sigil name={d.sigil} /></span>
        <div>
          <span class="kicker">{categories[d.category]} — {statuses[d.status]} · {d.year}</span>
          <h1>{d.title}</h1>
        </div>
      </div>
      <p class="lead">{d.summary}</p>
    </div>

    <div class="project-layout">
      <article class="prose"><Content /></article>
      <aside class="aside" aria-label="Informations sur le projet">
        {d.stack.length > 0 && (
          <div>
            <h2>Technologies</h2>
            <ul class="tags" role="list">{d.stack.map((s) => <li>{s}</li>)}</ul>
          </div>
        )}
        {d.links.length > 0 && (
          <div>
            <h2>Liens</h2>
            <div class="links">
              {d.links.map((l, i) => <a class={`pill ${i === 0 ? 'solid' : 'ghost'}`} href={l.url} rel="noopener">{l.label} ↗</a>)}
            </div>
          </div>
        )}
      </aside>
    </div>

    <nav class="suite" aria-label="Autres projets">
      {prev ? (
        <a class="suite-lien" href={url(`projets/${prev.id}/`)} rel="prev">
          <span class="suite-sens">← Précédent</span>
          <span class="suite-corps">
            <span class="sigil"><Sigil name={prev.data.sigil} /></span>
            <span class="suite-titre">{prev.data.title}</span>
          </span>
        </a>
      ) : <span class="suite-vide" aria-hidden="true"></span>}

      {next ? (
        <a class="suite-lien fin" href={url(`projets/${next.id}/`)} rel="next">
          <span class="suite-sens">Suivant →</span>
          <span class="suite-corps">
            <span class="suite-titre">{next.data.title}</span>
            <span class="sigil"><Sigil name={next.data.sigil} /></span>
          </span>
        </a>
      ) : <span class="suite-vide" aria-hidden="true"></span>}
    </nav>
  </div>
</Base>
