---
import { categories, statuses } from '../site';
import { url } from '../lib';
import Sigil from './Sigil.astro';
import type { SigilName } from './Sigil.astro';

interface Props {
  id: string; title: string; summary: string; year: number;
  category: keyof typeof categories; status: keyof typeof statuses;
  stack: string[]; sigil: SigilName; idx: number; total: number;
}
const p = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<article class="card">
  <span class="sigil"><Sigil name={p.sigil} /></span>
  <div class="card-body">
    <span class="idx">{pad(p.idx)} / {pad(p.total)} — {statuses[p.status]} · {p.year}</span>
    <h3><a href={url(`projets/${p.id}/`)}>{p.title}</a></h3>
    <p>{p.summary}</p>
    {p.stack.length > 0 && <ul class="tags" role="list">{p.stack.slice(0, 3).map((s) => <li>{s}</li>)}</ul>}
  </div>
</article>
